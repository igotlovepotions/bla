Redirect "C:\Users\brun\Desktop\aff\bla\ieee37mod.dss"
 

! ####Simulação 1: PV false, loadmult=1,
Set Loadmult=1.0
! ####Simulação 1: PV false, loadmult=1,
New Monitor.L1_potencia element=Line.L1 terminal=1 mode=1
New Monitor.L1_VI       element=Line.L1 terminal=1 mode=0
! ####Simulação 1: PV false, loadmult=1,
Set DataPath= C:\Users\brun\Desktop\aff\bla\results\1
 !1
Set mode=daily
Set number=24
Set Stepsize=1h
Set DemandInterval=true
Set overloadreport=true
Set voltexceptionreport=true
Set DIVerbose=true
Solve
CloseDI
! ####Simulação 1: PV false, loadmult=1,
Export Voltages voltages.csv
Export Overloads overloads.csv
Export Losses losses.csv
Export Generators generators.csv
Export monitors all
